DATABASE_URL="file:./dev.db"

# Origen permitido para CORS (debe coincidir con donde corre el frontend).
FRONTEND_URL="http://localhost:3000"

# Secreto usado para firmar/verificar los JWT emitidos por POST /api/auth/login.
# Generá el tuyo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="reemplazar-por-un-secreto-random-largo"

# Nombre de usuario (único) de la app.
APP_USERNAME="fernando"

# Hash bcrypt de la (única) password de la app.
# Generá el tuyo con: npm run hash-password -- "tuPasswordSegura"
APP_PASSWORD_HASH="reemplazar-por-un-hash-bcrypt"
